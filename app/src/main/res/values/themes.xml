<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FA1ROXX" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="Widget.FA1ROXX.QuickButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
    </style>
</resources>
